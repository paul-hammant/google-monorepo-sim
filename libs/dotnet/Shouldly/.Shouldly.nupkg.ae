//
// Consumers that dep on this file get Shouldly registered as a
// <PackageReference> in their generated .csproj. dotnet build handles
// the NuGet restore.

import bldr
import dotnet

main() {
    bldr.build() {
        dotnet.nuget_registry("Shouldly~4.3.0")
    }
}
