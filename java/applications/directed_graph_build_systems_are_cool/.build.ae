import build
import build (prereq)
import java

aeb(cap) {
    b = build.start()
    prereq(b, "jdk:21")
    build.dep(b, "java/components/consonants/.build.ae")
    build.dep(b, "java/components/fricatives/.build.ae")
    build.dep(b, "java/components/glides/.build.ae")
    build.dep(b, "java/components/nasal/.build.ae")
    build.dep(b, "kotlin/components/sonorants/.build.ae")
    build.dep(b, "java/components/velar/.build.ae")
    build.dep(b, "java/components/voiced/.build.ae")
    build.dep(b, "java/components/voiceless/.build.ae")
    build.dep(b, "java/components/vowels/.build.ae")
    java.javac(b)
}
