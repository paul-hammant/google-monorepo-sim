import build
import ts

main() {
    b = build.start()
    build.dep(b, "typescript/applications/mmmm/.build.ae")
    build.dep(b, "libs/javascript/assert/.assert.npm.ae")
    build.dep(b, "libs/javascript/mocha/.mocha.npm.ae")
    ts.tsc_files(b)
    ts.mocha(b, "target/tests/applications/mmmm/js/typescripttests/applications/mmmm/MmmmU0021Tests.js")
}
