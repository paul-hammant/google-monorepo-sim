import build
import dotnet
import dotnet (target_framework, root_namespace, assembly_name, test_project)

aeb(cap) {
    b = build.start()
    build.dep(b, "csharp/components/greek/.build.ae")
    build.dep(b, "libs/dotnet/xunit/.xunit.nupkg.ae")
    build.dep(b, "libs/dotnet/Shouldly/.Shouldly.nupkg.ae")
    dotnet.build_project(b) {
        target_framework("net10.0")
        assembly_name("GreekTests")
        root_namespace("Components.Greek.Tests")
        test_project()
    }
    dotnet.test(b)
}
