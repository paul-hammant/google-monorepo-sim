import build
import ts

main() {
    b = build.start()
    build.dep(b, "typescript/applications/mmmm")
    build.npm_dep(b, "libs:javascript/assert")
    build.npm_dep(b, "libs:javascript/mocha")
    ts.tsc_files(b)
    ts.mocha(b, "target/tests/applications/mmmm/js/typescripttests/applications/mmmm/MmmmU0021Tests.js")
}
