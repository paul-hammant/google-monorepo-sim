int build_junit(void* ctx) {
void* root = build__get(ctx, "root");
void* target_dir = build__get(ctx, "target_dir");
void* mod_dir = build__get(ctx, "module_dir");
const char* test_classes = path_join(target_dir, "test-classes");
const char* dep_cp = build__build_dep_classpath(ctx);
const char* lib_cp = build__build_lib_classpath(ctx);
const char* classpath = test_classes;
if (string_length(dep_cp) > 0) {
        {
const char* tmp = string_concat(classpath, ":");
classpath = string_concat(tmp, dep_cp);
        }
    }
if (string_length(lib_cp) > 0) {
        {
const char* tmp2 = string_concat(classpath, ":");
classpath = string_concat(tmp2, lib_cp);
        }
    }
const char* tc_pat = path_join(test_classes, "**/*Tests.class");
void* test_files = fs_glob(tc_pat);
int tcount = dir_list_count(test_files);
if (tcount == 0) {
        {
printf("%s: no test classes found", _aether_safe_str(mod_dir)); putchar('\n');
dir_list_free(test_files);
            return 0;
        }
    }
int prefix_len = (string_length(test_classes) + 1);
const char* class_names = "";
int j = 0;
while (j < tcount) {
        {
const char* f = dir_list_get(test_files, j);
int flen = string_length(f);
const char* class_path = string_substring(f, prefix_len, (flen - 6));
const char* tr_cmd = _aether_interp("echo '%s' | tr '/' '.'", _aether_safe_str(class_path));
const char* raw = os_exec(tr_cmd);
const char* class_name = string_trim(raw);
if (j == 0) {
                {
class_names = class_name;
                }
            } else {
                {
const char* sp = string_concat(class_names, " ");
class_names = string_concat(sp, class_name);
                }
            }
j = (j + 1);
        }
    }
dir_list_free(test_files);
printf("%s: running tests", _aether_safe_str(mod_dir)); putchar('\n');
const char* cmd = _aether_interp("java -cp %s org.junit.runner.JUnitCore %s", _aether_safe_str(classpath), _aether_safe_str(class_names));
int exit_code = os_system(cmd);
if (exit_code != 0) {
        {
printf("%s: tests FAILED", _aether_safe_str(mod_dir)); putchar('\n');
            return exit_code;
        }
    }
printf("%s: tests PASSED", _aether_safe_str(mod_dir)); putchar('\n');
    return 0;
}

