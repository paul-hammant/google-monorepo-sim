import bldr
import bldr (prereq)
import java

aeb(cap) {
    bldr.build() {
        prereq("jdk:21")
        dep("java/components/fricatives/.build.ae")
        dep("java/components/nasal/.build.ae")
        dep("kotlin/components/sonorants/.build.ae")
        dep("java/components/voiceless/.build.ae")
        dep("java/components/vowels/.build.ae")
        java.javac()
    }
}
