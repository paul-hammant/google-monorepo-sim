// xunit.nupkg.ae — xUnit test framework + runner + test SDK
//
// upstream: https://github.com/xunit/xunit
// versions: xunit 2.9.3, xunit.runner.visualstudio 3.1.1, Microsoft.NET.Test.Sdk 17.14.0
// license:  Apache-2.0
//
// Bundles the three NuGet packages needed to run xunit tests under
// `dotnet test`. Consumers dep on this single file rather than listing
// all three coords individually.

import bldr
import dotnet

main() {
    bldr.build() {
        dotnet.nuget_registry("xunit~2.9.3")
        dotnet.nuget_registry("xunit.runner.visualstudio~3.1.1")
        dotnet.nuget_registry("Microsoft.NET.Test.Sdk~17.14.0")
    }
}
