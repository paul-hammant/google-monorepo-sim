import build
import ts

aeb(cap) {
    b = build.start()
    build.dep(b, "typescript/components/explanation/.build.ae")
    build.dep(b, "libs/javascript/assert/.assert.npm.ae")
    build.dep(b, "libs/javascript/mocha/.mocha.npm.ae")
    ts.tsc_files(b)
    ts.mocha(b, "target/tests/typescripttests/components/explanation/js/typescripttests/components/explanation/ExplanationTests.js")
}
