import bldr
import dotnet
import dotnet (target_framework, root_namespace, assembly_name, test_project)

aeb(cap) {
    bldr.build() {
        dep("csharp/components/greek/.build.ae")
        dep("libs/dotnet/xunit/.xunit.nupkg.ae")
        dep("libs/dotnet/Shouldly/.Shouldly.nupkg.ae")
        dotnet.build_project() {
            target_framework("net10.0")
            assembly_name("GreekTests")
            root_namespace("Components.Greek.Tests")
            test_project()
        }
        dotnet.test()
    }
}
