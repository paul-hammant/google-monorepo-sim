import bldr
import dotnet
import dotnet (target_framework, root_namespace, output_type)

aeb(cap) {
    bldr.build() {
        dep("csharp/components/greek/.build.ae")
        dep("csharp/components/vowelbase/.build.ae")
        dotnet.build_project() {
            target_framework("net10.0")
            output_type("Exe")
            root_namespace("AlgorithmsSolveProblemsInGreek")
        }
    }
}
